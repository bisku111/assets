{
  "expo": {
    "name": "Maestro",
    "slug": "maestro-piano",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "maestro",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B10",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.maestro.piano",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Maestro usa il microfono per ascoltare le note che suoni al pianoforte e darti un feedback immediato. L'audio viene elaborato solo sul dispositivo: non viene mai registrato ne' inviato.",
        "NSBluetoothAlwaysUsageDescription": "Maestro usa il Bluetooth per collegarsi alle tastiere MIDI senza fili."
      }
    },
    "android": {
      "package": "com.maestro.piano",
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.BLUETOOTH_CONNECT"],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B10",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": { "output": "static", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#0B0B10", "image": "./assets/images/splash-icon.png", "imageWidth": 96 }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
