# Copia questo file in .env e compila i valori del tuo progetto Supabase.
# Solo le chiavi con prefisso EXPO_PUBLIC_ arrivano al bundle client: non
# inserire mai qui la service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Facoltativo. Se assente, l'app parte comunque in MODALITA' LOCALE:
# catalogo demo incluso nel bundle e progressi salvati sul dispositivo.
